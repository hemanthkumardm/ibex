# =====================================================================
# Stage 01: RTL Logic Synthesis & Technology Mapping (Yosys)
# =====================================================================
# Target:  lowRISC Ibex RV32IMC Core
# PDK:     SkyWater 130nm High-Density (sky130_fd_sc_hd)
# Reports: reports/01_synthesis/*
# =====================================================================

# 1. Read Synthesizable Verilog
read_verilog rtl/ibex_core.v

# 2. Elaborate Design Hierarchy
hierarchy -check -top ibex_core

# 3. High-Level Logic Optimizations & FSM Extraction
proc
opt
fsm
opt
memory
opt

# 4. Synthesize Arithmetic & Multiplexers
techmap
opt

# 5. Technology Mapping to SkyWater 130nm Standard Cells
abc -liberty sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# 6. Clean Unused Logic & Standardize Port Driving
clean

# 7. Generate Synthesis Diagnostic Reports
tee -o reports/01_synthesis/synth_check.rpt check
tee -o reports/01_synthesis/synth_stat.rpt stat -liberty sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# 8. Write Gate-Level Netlist
write_verilog outputs/synthesis_ibex_core.v
